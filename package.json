{
  "name": "mihomo-config-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-driven visual Mihomo configuration manager for Web and Android. Local-first, modular, and privacy-friendly.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json",
    "dev": "pnpm --filter @mcs/web dev",
    "build": "pnpm --filter @mcs/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:import-success-rate": "vitest run --config vitest.slow.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.18.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  }
}
