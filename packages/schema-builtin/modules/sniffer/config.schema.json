{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enable": {
      "type": "boolean",
      "default": false
    },
    "override-destination": {
      "type": "boolean",
      "default": false
    },
    "sniff": {
      "type": "object",
      "properties": {
        "HTTP": {
          "type": "object",
          "properties": {
            "ports": {
              "type": "array",
              "items": { "type": ["string", "integer"] }
            }
          }
        },
        "TLS": {
          "type": "object"
        },
        "QUIC": {
          "type": "object"
        }
      }
    }
  }
}
